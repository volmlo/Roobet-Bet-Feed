# --- Telegram ---
# Бот должен быть админом во всех трёх каналах.
TELEGRAM_BOT_TOKEN=

# Каналы (-100...). Любой можно оставить пустым — в него просто не будет отправки.
MAIN_CHAT_ID=
TT_CHAT_ID=
CONSENSUS_CHAT_ID=

# --- Пороги ---
MAIN_MIN_USD=300
MAIN_MIN_ODD=1.5
TT_MIN_USD=250
TT_MIN_ODD=1.5

# Отсекать кибер/виртуальные события (по флагу virtual). true/false.
EXCLUDE_CYBER=true

# --- Прогрузы ---
CONSENSUS_N=3
CONSENSUS_WINDOW_MS=60000
CONSENSUS_RETAIN_MS=360000
CONSENSUS_DEBOUNCE_MS=15000
CONSENSUS_MIN_USD=1

# Пауза между опросами ленты ставок, мс.
REFRESH_MS=3000

# --- Сторож тишины ---
# Куда слать служебные тревоги («фид завис»). Пусто → только в лог pm2.
# Можно свой user id (напиши боту /start) или отдельный приватный канал.
ALERT_CHAT_ID=
# Нет новых ставок дольше этого (мс) → тревога. По умолчанию 10 минут.
STALL_ALERT_MS=600000

# --- Чёрные списки (через запятую, регистр не важен, поиск по подстроке) ---
# Глобальные: исключают матч из ВСЕХ каналов (основной + НТ + прогрузы).
TEAM_BLACKLIST=
TOURNAMENT_BLACKLIST=

# Только для прогрузов: убирают матч ИЗ ПРОГРУЗОВ, не трогая основной канал.
# Сюда заносят топ-лиги, чтобы чистить прогрузы. Пример:
# CONSENSUS_TOURNAMENT_BLACKLIST=laliga,premier league,serie a,bundesliga,ligue 1
CONSENSUS_TEAM_BLACKLIST=
CONSENSUS_TOURNAMENT_BLACKLIST=

# --- Прокси (как в арбитражном проекте) ---
# Общий прокси для BetBy и Telegram. На Pi это локальный HTTP-релей gost.
PROXY_URL=http://127.0.0.1:8080
# при желании развести по сервисам:
# BETBY_PROXY=
# TELEGRAM_PROXY=

# Таймауты (опционально)
# HTTP_TIMEOUT_MS=20000
# CONNECT_TIMEOUT_MS=30000
